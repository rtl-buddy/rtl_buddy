#!/usr/bin/env bash
# Fake Verilator for CI dispatch tests: emit a simv that prints a PASS log.
#
# With $RB_SHIM_SPANS set it also records one `<mdir-basename> <start> <end>`
# line per invocation, so a test can prove the build job really compiled two
# distinct builds at the same time (#495). The sleep is what makes the spans
# wide enough to be compared at all: a serial build job produces disjoint
# spans, a parallel one overlapping ones. Off by default, so every other
# shim test keeps the instantaneous fake it had.
#
# With $RB_SHIM_HANG set it records its own pid in $RB_SHIM_PIDS and then
# sleeps that many seconds before doing any work, so a test can cancel the
# build job mid-compile and check that this process died with it rather than
# being orphaned (#495). Also off by default.
mdir=""
prev=""
for a in "$@"; do
  [ "$prev" = "--Mdir" ] && mdir="$a"
  prev="$a"
done
[ -z "$mdir" ] && { echo "no --Mdir" >&2; exit 1; }
# With $RB_SHIM_WAIT_FILE set it records its own pid in $RB_SHIM_PIDS and
# then blocks until that file exists (bounded, so a broken test fails rather
# than hanging the suite). That turns "a compile is in flight" into something
# a test can observe and then release on demand, which is what a build-lock
# race needs: park one builder inside the lock, let the second reach it, then
# let the first finish (#507).
if [ -n "${RB_SHIM_WAIT_FILE:-}" ]; then
  [ -n "${RB_SHIM_PIDS:-}" ] && echo "$$" >> "$RB_SHIM_PIDS"
  waited=0
  while [ ! -e "$RB_SHIM_WAIT_FILE" ] && [ "$waited" -lt 1200 ]; do
    sleep 0.1
    waited=$((waited + 1))
  done
fi
if [ -n "${RB_SHIM_HANG:-}" ]; then
  [ -n "${RB_SHIM_PIDS:-}" ] && echo "$$" >> "$RB_SHIM_PIDS"
  sleep "$RB_SHIM_HANG"
  [ -n "${RB_SHIM_PIDS:-}" ] && echo "survived $$" >> "$RB_SHIM_PIDS"
fi
start=""
if [ -n "${RB_SHIM_SPANS:-}" ]; then
  start=$(python3 -c 'import time; print("%.6f" % time.time())')
  sleep 0.5
fi
mkdir -p "$mdir"
cat > "$mdir/simv" <<'SIMV'
#!/usr/bin/env bash
echo "PASS (nwrn=  0)"
SIMV
chmod +x "$mdir/simv"
if [ -n "$start" ]; then
  end=$(python3 -c 'import time; print("%.6f" % time.time())')
  # One append per line: concurrent writers of a short line to an O_APPEND
  # fd do not interleave.
  echo "$(basename "$mdir") $start $end" >> "$RB_SHIM_SPANS"
fi
echo "fake-verilator: wrote $mdir/simv"
