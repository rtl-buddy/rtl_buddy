#!/usr/bin/env bash
# Fake sbatch: runs the job(s) synchronously and records element job ids.
# Job ids are monotonic (derived from the DB) so two arrays in one run
# never collide and cross-contaminate sacct telemetry rows.
db="${RB_SHIM_DB:-$PWD/.rb_shim_jobs}"
log="${RB_SHIM_LOG:-$db.log}"
jobid=$(( 1000 + $( [ -f "$db" ] && wc -l < "$db" || echo 0 ) ))
# The reservation flags below are consumed and discarded, so a test that
# wants to assert one (e.g. the build job's scaled --cpus-per-task, #495)
# needs the argv recorded before the loop eats it. Opt-in, one line per
# submission, so the shim's default behaviour is unchanged.
[ -n "${RB_SHIM_ARGV:-}" ] && printf '%s\n' "$*" >> "$RB_SHIM_ARGV"
array="" ; wrap="" ; chdir="" ; script="" ; manifest=""
args=("$@")
i=0
while [ $i -lt ${#args[@]} ]; do
  a="${args[$i]}"
  case "$a" in
    --array=*) array="${a#--array=}";;
    --chdir=*) chdir="${a#--chdir=}";;
    --wrap) i=$((i+1)); wrap="${args[$i]}";;
    --parsable|--time=*|--cpus-per-task=*|--mem=*|--job-name=*|--output=*|--qos=*|--partition=*|-*) : ;;
    *) if [ -z "$script" ]; then script="$a"; else manifest="$a"; fi;;
  esac
  i=$((i+1))
done
# Fail loud if the job's chdir is bad, rather than silently running the
# real _test-job from the wrong directory (an opaque empty-result failure).
[ -n "$chdir" ] && { cd "$chdir" || { echo "shim sbatch: cd $chdir failed" >&2; exit 1; }; }
# Tee both streams to $log so a broken _test-job is debuggable in CI.
run_one() { ( eval "$1" ) >>"$log" 2>&1 || true; }
if [ -n "$wrap" ]; then
  echo "$jobid" >> "$db"
  run_one "$wrap"
elif [ -n "$script" ] && [ -n "$manifest" ]; then
  n=$(wc -l < "$manifest")
  for k in $(seq 1 "$n"); do
    echo "${jobid}_${k}" >> "$db"
    export SLURM_ARRAY_TASK_ID="$k"
    run_one "bash '$script' '$manifest'"
  done
fi
echo "$jobid"
