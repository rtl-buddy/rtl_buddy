# OpenROAD P&R flow — templated by rb pnr.
#
# Placeholders are substituted by Python before openroad runs. Stage order:
#   read -> floorplan -> tie cells -> macros -> PDN -> pins -> port buffers ->
#   global place -> tie fanout -> resize -> legalize -> CTS -> detail place -> route ->
#   fill -> reports.

set DESIGN          {{ design }}
set NETLIST         {{ netlist }}
set SDC_FILE        {{ sdc }}

set LIBERTY         {{ liberty }}
set TECH_LEF        {{ tech_lef }}
set MACRO_LEF       {{ macro_lef }}

set SITE            {{ site }}
set CORE_UTIL_PCT   {{ util_pct }}
set CORE_ASPECT     {{ aspect }}
set CORE_MARGIN     {{ core_margin }}
set MACRO_HALO      {{ macro_halo }}
set MACRO_CELL_HALO {{ macro_cell_halo }}

set TIEHI_CELL_PORT {{ tie_hi }}
set TIELO_CELL_PORT {{ tie_lo }}
set CTS_BUF         {{ cts_buf }}
set SIGNAL_LAYERS   {{ signal_layers }}
set CLOCK_LAYERS    {{ clock_layers }}
set PIN_LAYER_H     {{ pin_layer_horizontal }}
set PIN_LAYER_V     {{ pin_layer_vertical }}

set FILL_CELLS      [list {{ fill_cells }}]

set OUT_DIR         {{ out_dir }}
# Written by global routing only when it overflows. Passed as this variable:
# the router keeps a pointer to the file name's Tcl string past the command.
set CONGESTION_RPT  $OUT_DIR/congestion.rpt
file mkdir $OUT_DIR
{{ threads_block }}{{ checkpoint_block }}{{ platform_tcl_block }}
puts ">>> Reading Liberty + LEF"
{{ read_liberty }}
read_lef     $TECH_LEF
read_lef     $MACRO_LEF
{{ extra_libs_lefs }}

puts ">>> Reading netlist"
read_verilog $NETLIST
link_design  $DESIGN

puts ">>> Reading SDC"
read_sdc $SDC_FILE
{{ max_fanout_block }}{{ layer_rc_block }}{{ dont_use_block }}
puts ">>> Initializing floorplan"
initialize_floorplan \
    -site         $SITE \
    -utilization  $CORE_UTIL_PCT \
    -aspect_ratio $CORE_ASPECT \
    -core_space   $CORE_MARGIN
{{ make_tracks }}
{{ blockages_block }}
puts ">>> Tie cells"
{{ tie_cells_block }}
{{ macro_pack_procs }}
puts ">>> Macro placement"
set block [ord::get_db_block]
# Macro origins snap to the site grid from the core corner; a bottom edge
# between two rows can fail DPL-0011 after legalization.
set site_obj [[lindex [$block getRows] 0] getSite]
set site_grid_dbu [list [$site_obj getWidth] [$site_obj getHeight]]
set dbu_per_micron [expr {int([ord::microns_to_dbu 1.0])}]
set macros {}
foreach inst [$block getInsts] {
  if {[[$inst getMaster] isBlock]} { lappend macros $inst }
}
if {[llength $macros] > 0} {
{{ macro_place_block }}  # A hard placement blockage over each macro grown by MACRO_CELL_HALO, so
  # no standard cell abuts a macro edge; the router reaches such a cell's pins
  # only with a Metal Spacing violation. Not `cut_rows`: that breaks the PDN
  # followpins. Uses the ODB API because the Tcl wrapper needs OpenROAD 26Q1.
  if {$MACRO_CELL_HALO > 0} {
    set cell_halo_dbu [expr {int(round([ord::microns_to_dbu $MACRO_CELL_HALO]))}]
    foreach inst $macros {
      set bbox [$inst getBBox]
      odb::dbBlockage_create $block \
          [expr {[$bbox xMin] - $cell_halo_dbu}] [expr {[$bbox yMin] - $cell_halo_dbu}] \
          [expr {[$bbox xMax] + $cell_halo_dbu}] [expr {[$bbox yMax] + $cell_halo_dbu}] \
          $inst
    }
  }
}
{{ tapcell_block }}{{ pdn_block }}
# Pins are placed after the macros and power grid so the pin placer sees placed
# macros (unplaced ones raise PPL-0015). `place_pins` only avoids boundary
# stretches a placed macro touches; keeping pins clear of macros kept a halo
# inside the core is `floorplan.macro-anchor`'s job.
puts ">>> IO pin placement"
{{ floorplan_pins_block }}{{ pin_constraints_tcl }}
place_pins -hor_layers $PIN_LAYER_H -ver_layers $PIN_LAYER_V
{{ buffer_ports_block }}
puts ">>> Global placement"
global_placement -density {{ place_density }} -pad_left {{ place_padding }} -pad_right {{ place_padding }}{{ reference_hpwl_option }}{{ routability_options }}
{{ tie_fanout_block }}
puts ">>> Resize"
estimate_parasitics -placement
repair_design

puts ">>> Detail placement (legalize)"
detailed_placement

puts ">>> Clock tree synthesis"
set_propagated_clock [all_clocks]
clock_tree_synthesis \
    -root_buf {{ cts_root_buf }} \
    -buf_list $CTS_BUF \
    {{ cts_clustering_option }}{{ cts_ndr_option }}

puts ">>> Detail placement (post-CTS)"
detailed_placement

puts ">>> Post-CTS timing repair"
estimate_parasitics -placement
{{ setup_repair }}repair_timing -hold

# repair_timing inserts unlegalized buffers; without this pass the
# detailed router fails with DRT-0073.
puts ">>> Detail placement (legalize repair cells)"
detailed_placement
# -verbose names each failing instance.
check_placement -verbose

# -verbose logs the per-layer usage table (GRT-0096) of every global route.
puts ">>> Global route"
set_routing_layers -signal $SIGNAL_LAYERS -clock $CLOCK_LAYERS
{{ layer_adjustment }}global_route -congestion_iterations 20 -congestion_report_file $CONGESTION_RPT -verbose
{{ global_route_hold_repair }}
puts ">>> Detail route"
detailed_route \
    -output_drc  $OUT_DIR/route.drc.rpt \
    -output_maze $OUT_DIR/route.maze.log \
    -verbose {{ detailed_route_verbose }}
{{ dont_use_check_block }}
puts ">>> Fill insertion"
filler_placement $FILL_CELLS
{{ rcx_block }}
puts ">>> Final reports"
{{ final_parasitics }}
report_design_area
# The routed design's instances, after every buffer, tie, tap and fill cell the
# flow added. Physical-only cells (LEF class CORE SPACER, CORE WELLTAP or
# ENDCAP*, or a master matching a fill-cells pattern as filler_placement
# matches it) are counted apart.
if {[catch {
  set rb_routed 0
  set rb_physical 0
  foreach inst [[ord::get_db_block] getInsts] {
    set master [$inst getMaster]
    set type [$master getType]
    set rb_is_fill 0
    foreach rb_fill $FILL_CELLS {
      if {[string match $rb_fill [$master getName]]} { set rb_is_fill 1; break }
    }
    if {$rb_is_fill || $type eq "CORE_SPACER" || $type eq "CORE_WELLTAP"
        || [string match ENDCAP* $type]} {
      incr rb_physical
    } else {
      incr rb_routed
    }
  }
  puts "{{ cell_count_tag }} routed $rb_routed physical $rb_physical"
} rb_err]} { puts "rb: routed cell count unavailable: $rb_err" }
report_worst_slack -max
report_worst_slack -min
report_tns
report_tns -min{{ corner_reports }}
report_checks -path_delay max -fields {slew cap input nets fanout} -format full_clock_expanded > $OUT_DIR/timing.rpt
# Max-slew, max-capacitance and max-fanout violators over every corner, as
# ORFS report_metrics counts them; the list goes to electrical.rpt.
foreach rb_check {slew capacitance fanout} {
  if {[catch {
    puts "{{ electrical_tag }} max_$rb_check [sta::max_${rb_check}_violation_count]"
  } rb_err]} { puts "rb: max $rb_check violator count unavailable: $rb_err" }
}
if {[catch {
  report_check_types -max_slew -max_capacitance -max_fanout -violators > $OUT_DIR/electrical.rpt
} rb_err]} { puts "rb: electrical.rpt unavailable: $rb_err" }

puts ">>> Write outputs"
write_def     $OUT_DIR/${DESIGN}.def
write_verilog $OUT_DIR/${DESIGN}.routed.v
write_sdc     $OUT_DIR/${DESIGN}.routed.sdc
# OpenROAD binary DB: placement, routing and parasitic annotations, so
# downstream tools (rb power with netlist-source: pnr) can re-enter at the
# post-route state.
#
# SPEF needs OpenRCX and PDK rules, so it is written only when the PDK declares
# `rcx-rules`: extraction runs after fill, `${DESIGN}.routed.spef` is written,
# and the final reports are timed on it. Without rules, rb power re-estimates
# parasitics from the ODB's global routes.
write_db      $OUT_DIR/${DESIGN}.routed.odb
{{ harden_block }}
puts ">>> DONE"
exit 0
