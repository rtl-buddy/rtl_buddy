# OpenROAD P&R flow — templated by rb pnr.
#
# Placeholders are substituted by Python before invoking openroad; no
# user-edits should be required. Stage order:
#   read -> floorplan -> pins -> tie cells -> global place -> resize ->
#   legalize -> CTS -> detail place -> route -> fill -> reports.

set DESIGN          {{ design }}
set NETLIST         {{ netlist }}
set SDC_FILE        {{ sdc }}

set LIBERTY         {{ liberty }}
set TECH_LEF        {{ tech_lef }}
set MACRO_LEF       {{ macro_lef }}

set SITE            {{ site }}
set CORE_UTIL_PCT   {{ util_pct }}
set CORE_ASPECT     {{ aspect }}
set CORE_MARGIN     {{ core_margin }}

set TIEHI_CELL_PORT {{ tie_hi }}
set TIELO_CELL_PORT {{ tie_lo }}
set CTS_BUF         {{ cts_buf }}
set SIGNAL_LAYERS   {{ signal_layers }}
set CLOCK_LAYERS    {{ clock_layers }}
set PIN_LAYER_H     {{ pin_layer_horizontal }}
set PIN_LAYER_V     {{ pin_layer_vertical }}

set FILL_CELLS      [list {{ fill_cells }}]

set OUT_DIR         {{ out_dir }}
file mkdir $OUT_DIR

puts ">>> Reading Liberty + LEF"
read_liberty $LIBERTY
read_lef     $TECH_LEF
read_lef     $MACRO_LEF
{{ extra_libs_lefs }}

puts ">>> Reading netlist"
read_verilog $NETLIST
link_design  $DESIGN

puts ">>> Reading SDC"
read_sdc $SDC_FILE
{{ dont_use_block }}
puts ">>> Initializing floorplan"
initialize_floorplan \
    -site         $SITE \
    -utilization  $CORE_UTIL_PCT \
    -aspect_ratio $CORE_ASPECT \
    -core_space   $CORE_MARGIN
make_tracks

puts ">>> IO pin placement"
place_pins -hor_layers $PIN_LAYER_H -ver_layers $PIN_LAYER_V

puts ">>> Tie cells"
if {[string length $TIEHI_CELL_PORT] > 0} { insert_tiecells $TIEHI_CELL_PORT }
if {[string length $TIELO_CELL_PORT] > 0} { insert_tiecells $TIELO_CELL_PORT }

puts ">>> Macro placement"
set block [ord::get_db_block]
set manuf_grid_dbu [expr {int([ord::microns_to_dbu 0.005])}]
set macros {}
foreach inst [$block getInsts] {
  if {[[$inst getMaster] isBlock]} { lappend macros $inst }
}
set macro_count [llength $macros]
if {$macro_count > 0} {
  set core [$block getCoreArea]
  set core_w [expr {double([$core xMax] - [$core xMin])}]
  set core_h [expr {double([$core yMax] - [$core yMin])}]
  set max_macro_w 0
  set max_macro_h 0
  foreach inst $macros {
    set master [$inst getMaster]
    set max_macro_w [expr {max($max_macro_w, [$master getWidth])}]
    set max_macro_h [expr {max($max_macro_h, [$master getHeight])}]
  }
  set ideal_cols [expr {sqrt(double($macro_count))}]
  set best_score [expr {double($macro_count + 1)}]
  set cols 0
  for {set candidate_cols 1} {$candidate_cols <= $macro_count} {incr candidate_cols} {
    set candidate_rows [expr {int(ceil(double($macro_count) / $candidate_cols))}]
    if {$max_macro_w <= $core_w / $candidate_cols &&
        $max_macro_h <= $core_h / $candidate_rows} {
      set score [expr {abs($candidate_cols - $ideal_cols)}]
      if {$score < $best_score} {
        set cols $candidate_cols
        set best_score $score
      }
    }
  }
  if {$cols == 0} {
    error "macros do not fit any rectangular grid in the floorplan core"
  }
  set rows [expr {int(ceil(double($macro_count) / $cols))}]
  set slot_w [expr {$core_w / $cols}]
  set slot_h [expr {$core_h / $rows}]
  for {set i 0} {$i < $macro_count} {incr i} {
    set inst [lindex $macros $i]
    set master [$inst getMaster]
    set col [expr {$i % $cols}]
    set row [expr {$i / $cols}]
    if {[$master getWidth] > $slot_w || [$master getHeight] > $slot_h} {
      error "macro [$inst getName] does not fit its floorplan grid slot"
    }
    set x [expr {[$core xMin] + $col * $slot_w + ($slot_w - [$master getWidth]) / 2.0}]
    set y [expr {[$core yMin] + $row * $slot_h + ($slot_h - [$master getHeight]) / 2.0}]
    set x [expr {int($x / $manuf_grid_dbu) * $manuf_grid_dbu}]
    set y [expr {int($y / $manuf_grid_dbu) * $manuf_grid_dbu}]
    $inst setLocation $x $y
    $inst setPlacementStatus FIRM
    puts ">>>   placed [$inst getName] at ($x, $y) DBU"
  }
}
{{ pdn_block }}
puts ">>> Global placement"
global_placement -density {{ place_density }} -pad_left {{ place_padding }} -pad_right {{ place_padding }}

puts ">>> Resize"
estimate_parasitics -placement
repair_design

puts ">>> Detail placement (legalize)"
detailed_placement

puts ">>> Clock tree synthesis"
set_propagated_clock [all_clocks]
clock_tree_synthesis \
    -root_buf {{ cts_root_buf }} \
    -buf_list $CTS_BUF \
    {{ cts_clustering_option }}

puts ">>> Detail placement (post-CTS)"
detailed_placement

puts ">>> Post-CTS timing repair"
estimate_parasitics -placement
repair_timing -hold

# repair_timing -hold inserts buffers at unlegalized locations; without a
# legalization pass here the detailed router has no access points for them
# and dies with DRT-0073 (#591).
puts ">>> Detail placement (legalize repair cells)"
detailed_placement
check_placement

puts ">>> Global route"
set_routing_layers -signal $SIGNAL_LAYERS -clock $CLOCK_LAYERS
global_route -congestion_iterations 20

puts ">>> Detail route"
detailed_route \
    -output_drc  $OUT_DIR/route.drc.rpt \
    -output_maze $OUT_DIR/route.maze.log \
    -verbose 0

puts ">>> Fill insertion"
filler_placement $FILL_CELLS

puts ">>> Final reports"
estimate_parasitics -global_routing
report_design_area
report_worst_slack -max
report_worst_slack -min
report_tns
report_checks -path_delay max -fields {slew cap input nets fanout} -format full_clock_expanded > $OUT_DIR/timing.rpt

puts ">>> Write outputs"
write_def     $OUT_DIR/${DESIGN}.def
write_verilog $OUT_DIR/${DESIGN}.routed.v
write_sdc     $OUT_DIR/${DESIGN}.routed.sdc
# OpenROAD binary DB. Captures placement + routing + parasitic
# annotations so downstream tools (rb power with netlist-source: pnr)
# can re-enter at the post-route state without re-running PnR.
#
# Note on SPEF: we intentionally do NOT call write_spef. Producing a
# real SPEF requires OpenROAD's RCX extractor (rcx_run) and a PDK-
# specific .rcx_rules file; Nangate45 / FreePDK45 doesn't ship one,
# and the estimate_parasitics-derived in-memory annotations are not
# extractable to SPEF ("[INFO RCX-0134] no extraction data."). The
# ODB-based handoff carries the same routing-derived cap to rb power
# without the calibration step.
write_db      $OUT_DIR/${DESIGN}.routed.odb

puts ">>> DONE"
exit 0
